# ==============================================================================
# Vetor — variáveis de ambiente (exemplo). Copie para .env e preencha com valores
# reais. NUNCA commitar o arquivo .env de verdade (já está no .gitignore).
# ==============================================================================

# --- Supabase (banco de dados, auth, storage) ---
# Ver docs/04-especificacao-tecnica-e-stack.md
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Usado pelos apps Next.js (landing/painel) no client-side
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- LLM (agentes de IA) ---
ANTHROPIC_API_KEY=

# --- WhatsApp Business (Meta Cloud API) — Agente Secretário ---
# Ver docs/03-arquitetura-de-agentes-e-prompts-mestre.md (Agente Secretário)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# "sandbox" usa o número de teste da Meta; "production" exige número real aprovado
WHATSAPP_MODE=sandbox

# --- Transcrição de áudio (Agente Secretário entende voz no WhatsApp) ---
# Ver docs/07-reposicionamento-agencia-completa.md, secao 4
# "sandbox" (padrao) responde pedindo texto em vez de tentar transcrever.
# "openai" usa a API de transcricao da OpenAI (exige OPENAI_API_KEY).
STT_PROVIDER=sandbox
OPENAI_API_KEY=

# --- Resposta em voz (o Vetor responde em áudio quando o cliente pergunta por áudio) ---
# "sandbox" (padrao) cai para texto em vez de tentar sintetizar.
# "openai" usa a API de fala da OpenAI (exige OPENAI_API_KEY, mesma chave acima).
# "fish" usa a Fish Audio (exige FISH_AUDIO_API_KEY e FISH_AUDIO_VOICE_ID) —
# permite um modelo de voz próprio/clonado em vez de uma voz genérica.
TTS_PROVIDER=sandbox
TTS_VOICE=onyx
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free

# --- Canal do Vetor dentro do painel (apps/painel <-> apps/agentes) ---
# Segredo compartilhado entre os dois serviços — gere uma string aleatoria longa
# e use o MESMO valor em apps/agentes e apps/painel.
INTERNAL_API_TOKEN=
# Usado só por apps/painel (server-side) para chamar apps/agentes.
AGENTES_API_URL=http://localhost:3333

# --- Marketing API do Meta — Agente de Tráfego (Fase 2+) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Conexões oficiais (OAuth) — Instagram / WhatsApp / Meta Ads/Business ---
# Ver apps/agentes/src/connections/providers.ts e apps/agentes/src/routes/connections.ts.
# Exige app criado no developers.facebook.com com os produtos habilitados
# (Instagram Business Login, WhatsApp Embedded Signup, Marketing API) — ver
# relatório final sobre App Review / Business Verification.
META_GRAPH_VERSION=v21.0
META_REDIRECT_URI=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# Embedded Signup (WhatsApp) usa a versão vigente recomendada pela Meta — a
# v2 é descontinuada em 15/10/2026, nunca hardcode essa versão antiga.
WHATSAPP_CONFIG_ID=
WHATSAPP_REDIRECT_URI=
# Chave AES-256 em base64 (32 bytes) — gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca reaproveitar entre ambientes; perder essa chave invalida todas as
# conexões já salvas (connections.encrypted_access_token/refresh_token).
TOKEN_ENCRYPTION_KEY=
# String secreta escolhida por nós, cadastrada também no painel da Meta ao
# configurar o webhook do app — valida a verificação GET em /webhooks/meta.
META_WEBHOOK_VERIFY_TOKEN=

# --- apps/landing: callback OAuth exigido pela Meta vive em vetormkt.online (raiz) ---
# apps/landing precisa das mesmas AGENTES_API_URL/INTERNAL_API_TOKEN acima
# pra encaminhar a troca de code por token (nunca guarda META_APP_SECRET).
PAINEL_URL=https://painel.vetormkt.online

# --- Higgsfield — geração de vídeo a partir de imagem (Agente de Vídeo) ---
# Ver apps/agentes/src/integrations/higgsfield.ts.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_MODEL_ID=
# Ajustável caso o endpoint real usado pela conta seja outro (não 100%
# confirmado na doc pública no momento da implementação — ver comentário no
# arquivo acima).
HIGGSFIELD_ENDPOINT_PATH=/higgsfield-ai/dop/standard

# --- Geração de imagem (Agente de Design) — provider gateway, nunca acoplado
# direto no agente/prompt. Ver apps/agentes/src/integrations/imageProvider.ts.
# "openai" (default) usa a API de imagens da OpenAI (gpt-image-1), mesma
# OPENAI_API_KEY já usada acima pra transcrição/voz.
IMAGE_PROVIDER=openai

# --- Asaas (cobrança/assinatura) ---
# Ver docs/05-integracao-pagamentos-assinatura.md
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# "sandbox" aponta para api-sandbox.asaas.com; "production" para api.asaas.com
ASAAS_ENV=sandbox

# --- Geral ---
NODE_ENV=development
PORT=3333
APP_BASE_URL=http://localhost:3000
